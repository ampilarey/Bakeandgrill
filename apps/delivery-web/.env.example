# Delivery / Driver App — Environment Variables
#
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# In production the build is served from the same origin as the API, so
# VITE_API_BASE_URL can be omitted (defaults to /api).
# Set it explicitly if the API is on a different domain.

# API base URL — set in production if the driver app is on a different origin from the backend.
# Example: VITE_API_BASE_URL=https://test.bakeandgrill.mv/api
VITE_API_BASE_URL=http://localhost:8000/api
