# ──────────────────────────────────────────────────────────────────────────────
# THIS FILE IS NOT THE ONE YOU WANT.
#
# This is the generic Laravel root .env.example and is NOT used by the
# Bake & Grill application. The real environment template is:
#
#   backend/.env.example
#
# Copy that file to backend/.env and fill in your values:
#   cp backend/.env.example backend/.env
#   php artisan key:generate   (run from backend/)
#
# For frontend apps, each app has its own .env.example:
#   apps/online-order-web/.env.example
#   apps/admin-dashboard/.env.example
#   apps/pos-web/.env.example
#   apps/kds-web/.env.example
#   apps/delivery-web/.env.example
# ──────────────────────────────────────────────────────────────────────────────
