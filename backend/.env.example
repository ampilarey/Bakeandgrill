APP_NAME="Bake & Grill"
# IMPORTANT: Change APP_ENV to 'production' on live server.
# 'local' disables many security hardening features (CSRF strictness, detailed errors, etc.)
APP_ENV=local
APP_KEY=   # IMPORTANT: Generate with `php artisan key:generate`
# IMPORTANT: Set APP_DEBUG=false in production — true exposes stack traces publicly.
APP_DEBUG=false
# IMPORTANT: Set APP_URL to your actual domain (https://...) in production.
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=daily
# IMPORTANT: Use LOG_LEVEL=warning in production — debug logs are verbose and expose request data.
# Switch to LOG_LEVEL=debug only for troubleshooting, then revert.
LOG_LEVEL=warning

# ── Database ─────────────────────────────────────────────────────────────────
# Generate a strong password: openssl rand -base64 32
# Docker Compose uses PostgreSQL 15 — keep DB_CONNECTION=pgsql for consistency.
# For local non-Docker development you may switch to mysql and DB_PORT=3306.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bakegrill
DB_USERNAME=bakegrill
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true   # Required for HTTPS deployments
# Set to your root domain (with leading dot) so the session cookie is shared
# between the Blade site and the /order React app (unified customer auth).
# PRODUCTION: SESSION_DOMAIN=.bakeandgrill.mv
# TEST (test.bakeandgrill.mv): leave EMPTY or set to test.bakeandgrill.mv (no
# leading dot). Sharing .bakeandgrill.mv with production causes CSRF 419s
# ("CSRF token mismatch") when a stale prod XSRF-TOKEN is sent to TEST.
SESSION_DOMAIN=.bakeandgrill.mv

# ── Sanctum SPA Auth ─────────────────────────────────────────────────────────
# Comma-separated list of domains that use Sanctum cookie-based (stateful) auth.
# The React order app checks GET /api/auth/customer/check on these domains
# to auto-login customers who authenticated on the Blade site.
# IMPORTANT: Add EVERY origin that hosts a Bake & Grill SPA — missing entries
# cause silent auth failures (customer logins appear to work but tokens aren't sent).
# Include your test domain during QA, remove it for final production deploy.
SANCTUM_STATEFUL_DOMAINS=bakeandgrill.mv,test.bakeandgrill.mv,app.bakeandgrill.mv,localhost,localhost:3003,localhost:3004
# Optional personal-access-token TTL in minutes (null = no expiry). Consider 480–1440 for production staff tokens.
# Global token TTL in minutes (optional). Also accepts legacy SANCTUM_EXPIRATION.
SANCTUM_TOKEN_EXPIRATION=
# Per-token TTL overrides (hours) — see config/sanctum.php
ADMIN_TOKEN_TTL_HOURS=24
# Default 72h — longer TTL keeps POS usable offline overnight; shorten if tokens are shared devices.
POS_TOKEN_TTL_HOURS=72
DRIVER_TOKEN_TTL_HOURS=12
# Behind nginx/Cloudflare reverse proxy — list explicit proxy IPs or CIDRs only (never '*').
# Required for correct HTTPS + client IP. All OTP/login rate limits are IP-based; trusting '*'
# lets clients spoof X-Forwarded-For and bypass throttles (costs real SMS money).
# Example (adjust for your host): TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
# TRUSTED_PROXIES=
# Safer default when Redis is flaky: QUEUE_CONNECTION=database
# (jobs survive a Redis restart; workers still run from the jobs table).
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# Throttle / RateLimiter store — keep off Redis so a Redis outage cannot 500
# throttled routes in middleware. database (default) or file both work.
CACHE_LIMITER_STORE=database
# When TEST and PRODUCTION share one Redis, give each install a distinct prefix
# so cache/rate-limit keys never collide (staff login locks, OTP codes, etc.).
# CACHE_PREFIX=bakegrill-test-cache-
# CACHE_PREFIX=bakegrill-prod-cache-

# ── Laravel Horizon (queue monitoring) ─────────────────────────────────────────
# Run `php artisan horizon` instead of `queue:work` when QUEUE_CONNECTION=redis.
# Dashboard: /horizon (owner / website.manage permission required in production).
HORIZON_PATH=horizon

# ── Scheduler heartbeat (optional dead-man's switch) ───────────────────────────
# When set, scheduler:heartbeat pings this URL every minute (e.g. Healthchecks.io).
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here
HEALTHCHECK_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Prefer phpredis when the PECL extension is installed (faster; also makes
# REDIS_MAX_RETRIES / REDIS_BACKOFF_* actually work — those keys are phpredis-only).
# Leave REDIS_CLIENT unset to auto-pick phpredis when available, else predis.
# REDIS_CLIENT=phpredis
# REDIS_CLIENT=predis
REDIS_SCHEME=unix
REDIS_PATH=/home/bakeandgrill/.redis/redis.sock
REDIS_HOST=127.0.0.1
REDIS_PORT=0
REDIS_PASSWORD=
# Fail-fast timeouts (seconds). Shared by both clients; a missing unix socket
# should error quickly instead of hanging a php-fpm worker.
REDIS_CONNECT_TIMEOUT=1.5
REDIS_READ_WRITE_TIMEOUT=2.0
# phpredis-only retry/backoff (ignored when REDIS_CLIENT=predis):
# REDIS_MAX_RETRIES=3
# REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
# REDIS_BACKOFF_BASE=100
# REDIS_BACKOFF_CAP=1000

# ── Mail ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Set MAIL_MAILER=smtp (or ses/mailgun) in production — 'log' silently drops all emails.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@bakeandgrill.mv"
MAIL_FROM_NAME="${APP_NAME}"

# ── Print Proxy ───────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
PRINT_PROXY_URL=http://127.0.0.1:3000
PRINT_PROXY_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── Dhiraagu SMS ──────────────────────────────────────────────────────────────
# Required for OTP and promotional SMS. Do not commit real credentials.
DHIRAAGU_API_URL=https://messaging.dhiraagu.com.mv/v1/api/sms
DHIRAAGU_SMS_USERNAME=CHANGE_ME_DHIRAAGU_USERNAME
DHIRAAGU_SMS_PASSWORD=CHANGE_ME_DHIRAAGU_PASSWORD
# Set true on staging/UAT (e.g. test.bakeandgrill.mv) when APP_ENV=local but real SMS is required.
SMS_LIVE=false

# ── Frontend URLs (CORS allowlist) ────────────────────────────────────────────
# Restrict to your actual domains in production. Do not use wildcards (*).
# Any SPA on a different origin that calls the API must be listed here.
FRONTEND_URL=http://localhost:3003
POS_URL=http://localhost:3001
KDS_URL=http://localhost:3002
DELIVERY_URL=http://localhost:3004
ADMIN_URL=http://localhost:3004

# ── BML Connect Payment Gateway ───────────────────────────────────────────────
# Real credentials provided by Bank of Maldives. Never commit real values.
# Webhook secret: generate with openssl rand -hex 32 and register in BML dashboard.
#
# UAT / staging (current test.bakeandgrill.mv setup):
#   BML_BASE_URL=https://api.uat.merchants.bankofmaldives.com.mv/public
#   BML_AUTH_MODE=raw
#   BML_ENFORCE_SIGNATURE=false
#   BML_ENVIRONMENT=sandbox
#
# Production (switch to these when going live with real BML credentials):
#   BML_BASE_URL=https://api.merchants.bankofmaldives.com.mv/public
#   BML_AUTH_MODE=auto
#   BML_ENFORCE_SIGNATURE=true
#   BML_ENVIRONMENT=production
#
BML_BASE_URL=https://api.uat.merchants.bankofmaldives.com.mv/public
BML_APP_ID=CHANGE_ME_BML_APP_ID
BML_API_KEY=CHANGE_ME_BML_API_KEY
BML_MERCHANT_ID=CHANGE_ME_BML_MERCHANT_ID
BML_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
BML_AUTH_MODE=raw
BML_RETURN_URL="${APP_URL}/payments/bml/return"
# Set this to the URL where customers land after payment (must match your deployed frontend).
FRONTEND_ORDER_STATUS_URL=https://test.bakeandgrill.mv/orders
BML_DEFAULT_CURRENCY=MVR
# IMPORTANT: Use 'sandbox' for UAT/staging, 'production' only with live BML credentials.
BML_ENVIRONMENT=sandbox
BML_ENFORCE_SIGNATURE=false
# Production (bakeandgrill.mv): MUST set BML_ENFORCE_SIGNATURE=true — boot guard rejects false.
# Test site uses production BML gateway; orders confirm via BML_RETURN_URL on test domain.
# BML_WEBHOOK_URL typically points at production; test webhook_logs may stay empty (expected).

# ── POS ───────────────────────────────────────────────────────────────────────
# Block only owner-disabled devices by default. Set true to require approved status too.
POS_STRICT_DEVICE_APPROVAL=false

# ── Promotions ────────────────────────────────────────────────────────────────
PROMO_CODE_CASE_INSENSITIVE=true

# ── Tax ───────────────────────────────────────────────────────────────────────
# TAX_RATE_BP: tax rate in basis points (100 bp = 1%). For 8% GST set to 800.
# IMPORTANT: This MUST match the item-level tax_rate percentages set in the admin menu.
# If items are set to 8% tax_rate in admin, set TAX_RATE_BP=800 here.
# Mismatch will cause checkout display total to differ from actual charged amount.
TAX_RATE_BP=800
TAX_INCLUSIVE=false

# ── Loyalty Program ───────────────────────────────────────────────────────────
LOYALTY_ENABLED=true
LOYALTY_EARN_RATE=1
LOYALTY_REDEEM_RATE=100
LOYALTY_MIN_REDEEM=100
LOYALTY_MAX_REDEEM=10000
LOYALTY_MAX_REDEEM_PERCENT=50
LOYALTY_HOLD_TTL=30
LOYALTY_TIERS_ENABLED=false

# ── Xero OAuth 2.0 ───────────────────────────────────────────────────────────
# OAuth credentials from https://developer.xero.com
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://yourapp.com/api/xero/callback
XERO_REVENUE_ACCOUNT=200
XERO_EXPENSE_ACCOUNT=400
XERO_BANK_ACCOUNT=090

# ── Stripe Payment Gateway ────────────────────────────────────────────────────
# Keys from https://dashboard.stripe.com
# Webhook secret: generate in Stripe dashboard under Webhooks.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Web Push (VAPID) Notifications ───────────────────────────────────────────
# Generate keys: php artisan push:generate-vapid
# Add the public key to online-order-web as VITE_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Real-time SSE ─────────────────────────────────────────────────────────────
# Set to true to use Redis pub/sub for SSE instead of DB polling (lower latency)
# Requires Redis server and REDIS_HOST to be configured above.
REALTIME_USE_REDIS=false

# ── Database backups (spatie/laravel-backup) ───────────────────────────────────
# Comma-separated filesystem disks from config/filesystems.php (backups = local, s3 = off-site).
BACKUP_DISKS=backups
# For S3-compatible off-site storage add: BACKUP_DISKS=backups,s3 and configure AWS_* below.
BACKUP_NOTIFICATION_EMAIL=
BACKUP_MAX_AGE_DAYS=2
BACKUP_MAX_STORAGE_MB=5000
# Optional zip encryption password (null = no encryption)
BACKUP_ARCHIVE_PASSWORD=

# ── TEST immediate auto-deploy webhook ───────────────────────────────────────
# TEST server only (test.bakeandgrill.mv). Leave empty on production.
# Generate: openssl rand -hex 32
# Set the SAME value as GitHub Actions secret TEST_DEPLOY_WEBHOOK_SECRET
# on the `test` environment. See docs/TEST_AUTO_DEPLOY.md.
TEST_DEPLOY_WEBHOOK_SECRET=
# TEST_DEPLOY_ALLOWED_HOSTS=test.bakeandgrill.mv

# ── Error Monitoring (Sentry) ──────────────────────────────────────────────────
# Sign up at https://sentry.io (free tier is sufficient).
# Leave blank to disable — exceptions will only go to the log file.
SENTRY_LARAVEL_DSN=
# Capture 10% of transactions for performance monitoring (0.0 = off, 1.0 = all)
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
